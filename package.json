{
  "name": "takatak-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "https-proxy-agent": "^7.0.6",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "prettier": "^3.9.10",
    "vite": "^7.3.0"
  }
}
