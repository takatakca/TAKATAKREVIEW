# No credentials are required for loopback-only local development.
PORT=4100
HOST=127.0.0.1
DATA_FILE=var/review.sqlite

# Production: use the EXISTING TAKATAK identity provider. No local user directory.
# NODE_ENV=production
APP_ORIGIN=
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# Existing TAKATAK billing/Stripe portal, e.g. the canonical Growth pricing route.
TAKATAK_BILLING_URL=

# Native Google Business Profile. Requires approved Google Business Profile API access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte random key, hex encoded (64 hex characters). Store as a server secret.
GOOGLE_TOKEN_ENCRYPTION_KEY=
ALLOW_GOOGLE_SYNC=false
GOOGLE_SYNC_INTERVAL_SECONDS=900

# Optional relay for providers with approved management access.
# This contract must be implemented by an authorized ecosystem adapter.
REVIEW_BRIDGE_URL=
REVIEW_BRIDGE_KEY=
# Timestamped HMAC secret for trusted provider ingress (do not use a proxy placeholder here).
REVIEW_WEBHOOK_SECRET=

# Sending is off by default. A verified email sender and actual API key are required.
ALLOW_DELIVERY=false
RESEND_API_KEY=
EMAIL_FROM=
